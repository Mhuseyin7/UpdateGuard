FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /updateguard-agent ./cmd/agent
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /updateguard-agent /updateguard-agent
USER nonroot:nonroot
EXPOSE 8081
ENTRYPOINT ["/updateguard-agent"]
